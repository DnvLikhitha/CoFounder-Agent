# Match the local PostgreSQL account and database you created.
DATABASE_URL=postgresql://dev:devpassword@127.0.0.1:5432/cofounder_db
ENVIRONMENT=development
V1_PROVIDER_MODE=fake
CORS_ORIGINS=http://localhost:5173

# Use the exact issuer origin from the isolated Supabase project.
SUPABASE_URL=http://127.0.0.1:54321

# For local API tests, unset SUPABASE_URL, opt in, and set a private signing secret.
V1_ALLOW_TEST_JWT=false
V1_JWT_SECRET=
V1_JWT_ISSUER=cofounder-agent
V1_JWT_AUDIENCE=cofounder-api

MAX_CONCURRENT_RUNS=5
V1_STEP_CONCURRENCY=2
V1_REQUIRE_PRICING_REVIEW=true
V1_REQUIRE_FOUNDER_REVIEW=false
V1_LLM_EVALUATION=false

# Set approved server-side credentials before switching to live mode.
GROQ_API_KEY=
SERPAPI_API_KEY=
FRED_API_KEY=
V1_PROVIDER_TIMEOUT_SECONDS=120
V1_RUN_TOKEN_LIMIT=500000
V1_RUN_COST_LIMIT_NANOUSD=250000000
